{
  "name": "keycloak-toolkit",
  "displayName": "Toolkit for Keycloak (Community)",
  "description": "Token playground, realm-as-code diff and developer workflows for Keycloak. Unofficial community project.",
  "version": "0.0.1",
  "publisher": "nouhaila",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nouhaila/keycloak-toolkit"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "keycloak",
    "oidc",
    "oauth2",
    "jwt",
    "iam",
    "identity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "keycloak.decodeJwt",
        "title": "Decode JWT",
        "category": "Keycloak"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "jose": "^5.9.6"
  }
}
