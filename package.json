{
  "name": "keycloak-toolkit",
  "displayName": "Toolkit for Keycloak (Community)",
  "description": "Token playground, realm-as-code diff and developer workflows for Keycloak. Unofficial community project.",
  "version": "0.0.1",
  "publisher": "nouhamk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nouhamk/keycloak-toolkit"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "keycloak",
    "oidc",
    "oauth2",
    "jwt",
    "iam",
    "identity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "*.realm.json",
          "*-realm.json",
          "realm-export.json"
        ],
        "url": "./schemas/realm.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.realm.yaml",
          "*.realm.yml"
        ],
        "url": "./schemas/realm.schema.json"
      }
    ],
    "configuration": {
      "title": "Keycloak",
      "properties": {
        "keycloak.tokens.scope": {
          "type": "string",
          "default": "openid profile email",
          "description": "Scopes requested for user logins (authorization code, device code, password)."
        },
        "keycloak.tokens.allowPasswordGrant": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Offer the legacy Resource Owner Password grant. **Development only**: it is deprecated in OAuth 2.1."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "keycloak",
          "title": "Keycloak",
          "icon": "$(key)"
        }
      ]
    },
    "views": {
      "keycloak": [
        {
          "id": "keycloak.explorer",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "keycloak.explorer",
        "contents": "No Keycloak connections yet.\n[Add Connection](command:keycloak.addConnection)\n[Decode a JWT](command:keycloak.decodeJwt)"
      }
    ],
    "commands": [
      {
        "command": "keycloak.addConnection",
        "title": "Add Connection",
        "category": "Keycloak",
        "icon": "$(add)"
      },
      {
        "command": "keycloak.removeConnection",
        "title": "Remove Connection",
        "category": "Keycloak",
        "icon": "$(trash)"
      },
      {
        "command": "keycloak.refresh",
        "title": "Refresh",
        "category": "Keycloak",
        "icon": "$(refresh)"
      },
      {
        "command": "keycloak.filter",
        "title": "Filter",
        "category": "Keycloak",
        "icon": "$(filter)"
      },
      {
        "command": "keycloak.clearFilter",
        "title": "Clear Filter",
        "category": "Keycloak",
        "icon": "$(clear-all)"
      },
      {
        "command": "keycloak.unlockProd",
        "title": "Unlock Production Connection",
        "category": "Keycloak",
        "icon": "$(unlock)"
      },
      {
        "command": "keycloak.lockProd",
        "title": "Lock Production Connection",
        "category": "Keycloak",
        "icon": "$(lock)"
      },
      {
        "command": "keycloak.pullRealm",
        "title": "Pull Realm to File",
        "category": "Keycloak",
        "icon": "$(cloud-download)"
      },
      {
        "command": "keycloak.compareWithLive",
        "title": "Compare with Live Realm",
        "category": "Keycloak",
        "icon": "$(diff)"
      },
      {
        "command": "keycloak.compareRealms",
        "title": "Compare Two Realms",
        "category": "Keycloak",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "keycloak.explainAccess",
        "title": "Explain Access…",
        "category": "Keycloak",
        "icon": "$(question)"
      },
      {
        "command": "keycloak.getToken",
        "title": "Get Token",
        "category": "Keycloak",
        "icon": "$(key)"
      },
      {
        "command": "keycloak.decodeJwt",
        "title": "Decode JWT",
        "category": "Keycloak"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "keycloak.addConnection",
          "when": "view == keycloak.explorer",
          "group": "navigation@1"
        },
        {
          "command": "keycloak.filter",
          "when": "view == keycloak.explorer",
          "group": "navigation@2"
        },
        {
          "command": "keycloak.clearFilter",
          "when": "view == keycloak.explorer && keycloak.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "keycloak.refresh",
          "when": "view == keycloak.explorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "keycloak.explainAccess",
          "when": "view == keycloak.explorer && viewItem == user",
          "group": "inline"
        },
        {
          "command": "keycloak.explainAccess",
          "when": "view == keycloak.explorer && viewItem =~ /^(user|realm)$/",
          "group": "0_access"
        },
        {
          "command": "keycloak.pullRealm",
          "when": "view == keycloak.explorer && viewItem == realm",
          "group": "2_realm@1"
        },
        {
          "command": "keycloak.compareRealms",
          "when": "view == keycloak.explorer && viewItem == realm",
          "group": "2_realm@2"
        },
        {
          "command": "keycloak.getToken",
          "when": "view == keycloak.explorer && viewItem == client",
          "group": "inline"
        },
        {
          "command": "keycloak.getToken",
          "when": "view == keycloak.explorer && viewItem == client",
          "group": "0_token"
        },
        {
          "command": "keycloak.refresh",
          "when": "view == keycloak.explorer && viewItem =~ /^(connection|realm|category)/",
          "group": "inline"
        },
        {
          "command": "keycloak.unlockProd",
          "when": "view == keycloak.explorer && viewItem == connection.prod",
          "group": "1_prod"
        },
        {
          "command": "keycloak.lockProd",
          "when": "view == keycloak.explorer && viewItem == connection.prod",
          "group": "1_prod"
        },
        {
          "command": "keycloak.removeConnection",
          "when": "view == keycloak.explorer && viewItem =~ /^connection/",
          "group": "9_remove"
        }
      ],
      "explorer/context": [
        {
          "command": "keycloak.compareWithLive",
          "when": "resourceExtname == .json",
          "group": "3_compare"
        }
      ],
      "editor/title": [
        {
          "command": "keycloak.compareWithLive",
          "when": "resourceScheme == file && resourceFilename =~ /realm.*\\.json$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "keycloak.decodeJwt",
          "when": "editorHasSelection",
          "group": "9_keycloak"
        }
      ],
      "commandPalette": [
        {
          "command": "keycloak.refresh",
          "when": "false"
        },
        {
          "command": "keycloak.clearFilter",
          "when": "keycloak.filterActive"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "jose": "^5.9.6"
  }
}
